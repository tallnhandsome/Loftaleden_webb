---
// Google My Maps laddas först när besökaren klickar, så att inga
// anrop går till Google vid vanlig sidvisning (GDPR-hänsyn).
const MID = '15mDTt3IuzaLr8rc26dpEHk7Lfg0DaHc';
const embedUrl = `https://www.google.com/maps/d/embed?mid=${MID}`;
---

<div class="kartruta" id="kartruta" data-embed={embedUrl}>
	<p><strong>Karta över Löftaleden</strong></p>
	<p>
		Kartan visas via Google Maps. Inget laddas från Google förrän du väljer att visa
		kartan.
	</p>
	<button type="button" id="visa-karta" class="knapp">Visa kartan</button>
	<noscript>
		<p>
			<a href={`https://www.google.com/maps/d/viewer?mid=${MID}`}>
				Öppna kartan på Google Maps
			</a>
		</p>
	</noscript>
</div>

<script is:inline>
	document.getElementById('visa-karta').addEventListener('click', function () {
		var ruta = document.getElementById('kartruta');
		var iframe = document.createElement('iframe');
		iframe.src = ruta.dataset.embed;
		iframe.title = 'Karta över Löftaleden (Google My Maps)';
		iframe.loading = 'lazy';
		iframe.allowFullscreen = true;
		ruta.replaceChildren(iframe);
		ruta.classList.add('laddad');
	});
</script>

<style>
	.kartruta {
		background: var(--tint);
		border: 1px solid var(--tint-2);
		border-radius: 10px;
		padding: 2em;
		text-align: center;
	}
	.kartruta.laddad {
		padding: 0;
		overflow: hidden;
	}
	.kartruta :global(iframe) {
		display: block;
		width: 100%;
		height: 70vh;
		min-height: 420px;
		border: 0;
	}
</style>
