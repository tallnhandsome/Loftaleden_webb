---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const punkter = (await getCollection('infopunkter')).sort(
	(a, b) => a.data.ordning - b.data.ordning,
);
---

<BaseLayout
	title="Informationspunkter"
	description="Informationsskyltarna längs Löftaleden – natur, byar och kulturhistoria i Löftaåns dalgång."
>
	<h1>Informationspunkter längs sträckan</h1>
	<p class="ingress">
		Längs leden står skyltar som berättar om platsernas natur och historia. Här finns
		samma texter att läsa hemma – eller på plats om skylten är svår att hinna med.
	</p>
	<div class="grid">
		{
			punkter.map((punkt) => (
				<article>
					<a href={`/informationspunkter/${punkt.id}/`}>
						<Image
							src={punkt.data.bild}
							alt={punkt.data.bildAlt}
							widths={[480, 960]}
							sizes="(max-width: 720px) 100vw, 460px"
						/>
						<h2>{punkt.data.titel}</h2>
					</a>
					<p>{punkt.data.ingress}</p>
				</article>
			))
		}
	</div>
</BaseLayout>

<style>
	.ingress {
		max-width: 46em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5em 2em;
		margin-top: 2em;
	}
	article a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	article img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		max-width: 100%;
		height: auto;
		border-radius: 10px;
		margin-bottom: 0.6em;
	}
	article h2 {
		font-size: 1.3em;
		margin-bottom: 0.3rem;
	}
	article a:hover h2,
	article a:focus-visible h2 {
		color: var(--accent);
		text-decoration: underline;
	}
	article p {
		margin: 0;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
